#!/bin/bash
#PBS -N gen_gr_50k_s
#PBS -q v1_small24
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=16:mem=128gb
#PBS -j oe
#PBS -o /rds/general/user/jc5322/home/Project/Msci-GW/hpc_outputs/

# 50k test on v1_small24 for faster queue turnaround. Matches the proven
# 200k config (16 cores, num_workers=16) but now benefits from the thread
# caps and parallel _whiten_batch fixes. Complements gen_gr_50k_test.pbs
# which exercises the target 32-core v1_medium24 config.

# Redirect stdout/stderr to a live log in hpc_outputs/ we can tail from the
# login node while the job is still running. PBS's final .OU is still
# written at job end as normal.
LIVE_LOG="/rds/general/user/jc5322/home/Project/Msci-GW/hpc_outputs/live_${PBS_JOBID%%.*}.log"
exec > >(tee "$LIVE_LOG") 2>&1

module purge
module load tools/prod
module load Python/3.11.3-GCCcore-12.3.0
source /rds/general/user/jc5322/home/venv/gwtorchenv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export WHITEN_WORKERS=16

REPO_ROOT="/rds/general/user/jc5322/home/Project/Msci-GW"
DATAGEN_DIR="$REPO_ROOT/HPC/Pipeline/Data Generation"
OUTPUT_DIR="$REPO_ROOT/HPC/Pipeline/Data"
OUTPUT_PATH="$OUTPUT_DIR/gr_50k_test_small.pt"

mkdir -p "$OUTPUT_DIR"
cd "$DATAGEN_DIR"

echo "=== DEBUG INFO ==="
echo "hostname:     $(hostname)"
echo "pwd:          $(pwd)"
python -V
python -c "import pycbc, torch; print('pycbc', pycbc.__version__); print('torch', torch.__version__)"

echo
echo "=== Thread env vars ==="
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS  OPENBLAS_NUM_THREADS=$OPENBLAS_NUM_THREADS"
echo "MKL_NUM_THREADS=$MKL_NUM_THREADS  NUMEXPR_NUM_THREADS=$NUMEXPR_NUM_THREADS"
echo "WHITEN_WORKERS=$WHITEN_WORKERS"

echo
echo "=== Pre-flight: import gw_datagen ==="
python -c "from gw_datagen import pycbc_data_generator, save_dataloaders, _whiten_batch; print('gw_datagen imports OK')" || exit 1

echo
echo "=== Verify PSD cache ==="
python -c "
import os, sys, numpy as np
cache = os.path.join(os.getcwd(), 'o4_psd_cache')
for det in ('H1', 'L1'):
    p = os.path.join(cache, f'o4_psds_{det}_4096Hz.npz')
    if not os.path.isfile(p):
        print(f'MISSING: {p}'); sys.exit(1)
    n = np.load(p)['psds'].shape[0]
    print(f'  {det}: {n} PSDs at {p}')
" || exit 1

echo
echo "=== Generate 50,000 GR waveforms → $OUTPUT_PATH ==="
OUTPUT_PATH="$OUTPUT_PATH" python <<'PY'
import os, time
import numpy as np
from gw_datagen import pycbc_data_generator, save_dataloaders

OUTPUT_PATH = os.environ['OUTPUT_PATH']

CONFIG = {
    'mass1':        lambda size: np.random.uniform(5, 90, size=size),
    'mass2':        lambda size: np.random.uniform(5, 90, size=size),
    'spin1z':       lambda size: np.random.uniform(-0.8, 0.8, size=size),
    'spin2z':       lambda size: np.random.uniform(-0.8, 0.8, size=size),
    'distance':     lambda size: np.random.uniform(100, 5000, size=size),
    'inclination':  lambda size: np.arccos(np.random.uniform(-1, 1, size=size)),
    'coa_phase':    lambda size: np.random.uniform(0, 2 * np.pi, size=size),
    'ra':           lambda size: np.random.uniform(0, 2 * np.pi, size=size),
    'dec':          lambda size: np.arcsin(np.random.uniform(-1, 1, size=size)),
    'polarization': lambda size: np.random.uniform(0, np.pi, size=size),
    'm_g':          lambda size: np.zeros(size),
    'alpha_lv':     lambda size: np.zeros(size),
    'A':            lambda size: np.zeros(size),
}

t0 = time.time()
result = pycbc_data_generator(
    config=CONFIG,
    num_samples=50000,
    time_resolution=1 / 4096,
    approximant='IMRPhenomD',
    f_lower=10.0,
    f_final=2048.0,
    signal_length=2.0,
    batch_size=512,
    train_split=0.8,
    val_split=0.1,
    add_noise=True,
    noise_backend='o4_psd',
    num_workers=16,
)
t_gen = time.time() - t0
print(f'\n[timing] generation: {t_gen:.1f} s')

t0 = time.time()
save_dataloaders(result, OUTPUT_PATH)
t_save = time.time() - t0
print(f'[timing] save (incl. whitening): {t_save:.1f} s')

meta = result['metadata']
print(f"\nDataset saved to {OUTPUT_PATH}")
print(f"  Waveform shape     : {meta['waveform_shape']}")
print(f"  Train / val / test : {meta['train_size']} / {meta['val_size']} / {meta['test_size']}")
print(f"  Parameters         : {meta['parameter_names']}")
PY
EXIT_CODE=$?

echo
echo "=== Done (exit $EXIT_CODE) ==="
exit $EXIT_CODE
